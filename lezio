#!/usr/bin/env bash
# lezio command line. Run ./lezio --help for the list of commands.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ ! -x "$DIR/.venv/bin/python" ]; then
  echo "Environment not installed. Run ./setup.sh first." >&2
  exit 1
fi
PYTHONPATH="$DIR/src" PYTHONUNBUFFERED=1 exec "$DIR/.venv/bin/python" -m lezio "$@"
